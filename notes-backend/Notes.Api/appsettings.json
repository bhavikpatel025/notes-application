{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://notes-application-frontend-lemon.vercel.app"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=dummy_host;Port=5432;Database=dummy_db;Username=dummy_user;Password=dummy_password"
  },
  "JwtSettings": {
    "Secret": "Replace_This_With_A_Long_Secure_Secret_Key!",
    "Issuer": "KeepNotesApi",
    "Audience": "KeepNotesClient",
    "ExpirationInHours": "24"
  },
  "Cloudinary": {
    "Url": "cloudinary://dummy_api_key:dummy_api_secret@dummy_cloud_name"
  },
  "Google": {
    "ClientId": "dummy_google_client_id.apps.googleusercontent.com"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your_email@gmail.com",
    "Password": "your_app_password",
    "SenderEmail": "your_email@gmail.com",
    "SenderName": "Keep Notes"
  }
}
